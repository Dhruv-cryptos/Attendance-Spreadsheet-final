# DataGuard AI environment template — copy to .env and fill in.
# NEVER put real credentials in this file or in frontend code.

# Supabase (pre-populated by the platform; used to call the gemini-chat edge function)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini API key — set as a SUPABASE EDGE FUNCTION SECRET, not here.
# Server-side only: Project Settings → Edge Functions → Secrets → GEMINI_API_KEY
# Get a key at https://aistudio.google.com/apikey
